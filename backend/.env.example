# Runtime environment. Meanings:
#   dev        = development (lenient: auto-create tables, relaxed guards)
#   prod       = production (strict: postgres DB, explicit ALLOWED_HOSTS,
#                explicit non-default SECRET_KEY >= 32 chars)
#   production = same as prod (accepted as an alias)
# Any other value is a startup error.
APP_ENV=dev
# SQLite for development; production must use postgresql:// (a "+driver"
# suffix such as postgresql+psycopg:// is accepted).
DATABASE_URL=sqlite:///./student_management.db
# Development default (do NOT use in production). In prod, set an explicit
# secret that is NOT the development default and is at least 32 characters.
SECRET_KEY=dev-secret-key-change-me-32bytes-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Production requires this to be set explicitly (the dev fallback
# "localhost,127.0.0.1" is not accepted in prod).
ALLOWED_HOSTS=localhost,127.0.0.1
# ---- School branding (single source for login page, sidebar, tab title, PDF) ----
# SCHOOL_LOGO must be a plain filename (no path separators) inside
# src/student_management/static/branding/ with one of .png/.jpg/.jpeg/.webp.
# Missing file = startup error. BRAND_DEMO=true shows a "Demo preview" badge.
SCHOOL_NAME=Usman Public School
SCHOOL_TAGLINE=Knowledge, Character, Excellence
BRAND_PRIMARY_COLOR=#0B6B4F
BRAND_SECONDARY_COLOR=#D9A441
BRAND_DEMO=true
SCHOOL_LOGO=logo.png